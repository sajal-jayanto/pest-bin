{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false
  },
  "tasks": {
    "dev": "deno run --env-file=.env --allow-env --allow-net --allow-read --allow-sys --watch src/server.ts",
    "migration:create": "deno run -A --env-file=.env scripts/migration.ts create",
    "migration:run": "deno run -A --env-file=.env scripts/migration.ts run",
    "migration:revert": "deno run -A --env-file=.env scripts/migration.ts revert",
    "migration:show": "deno run -A --env-file=.env scripts/migration.ts show"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "cors": "npm:cors@^2.8.6",
    "express": "npm:express@^5.2.1",
    "helmet": "npm:helmet@^8.3.0",
    "http-status-codes": "npm:http-status-codes@^2.3.0",
    "lodash": "npm:lodash@^4.18.1",
    "pg": "npm:pg@^8.23.0",
    "pino": "npm:pino@^10.3.1",
    "pino-http": "npm:pino-http@^11.0.0",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "reflect-metadata": "npm:reflect-metadata@^0.2.2",
    "typeorm": "npm:typeorm@^1.1.1",
    "zod": "npm:zod@^4.5.4"
  }
}
